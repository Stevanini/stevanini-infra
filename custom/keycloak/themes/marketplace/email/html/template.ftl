<#macro emailLayout>
<!doctype html>
<html lang="pt-BR"><head><meta charset="utf-8"><meta name="color-scheme" content="only light"><meta name="supported-color-schemes" content="only light"><style>
:root{color-scheme:only light;supported-color-schemes:only light}
[data-ogsb] .pg{background:#E6E7E8 !important}[data-ogsb] .cd{background:#F7F7F6 !important;border-color:#C6C9CC !important}[data-ogsb] .gd{background:#E0B04B !important}
[data-ogsc] .tx{color:#1F2428 !important}[data-ogsc] .sf{color:#4E565C !important}[data-ogsc] .bt{color:#1A1405 !important}
</style></head>
<body class="pg" bgcolor="#E6E7E8" style="margin:0;padding:0;background:#E6E7E8;font-family:Arial,Helvetica,sans-serif;color:#1F2428">
<table role="presentation" class="pg" width="100%" cellpadding="0" cellspacing="0" bgcolor="#E6E7E8" style="background:#E6E7E8"><tr><td align="center" style="padding:32px 12px">
<table role="presentation" class="cd" width="440" cellpadding="0" cellspacing="0" bgcolor="#F7F7F6" style="width:100%;max-width:440px;background:#F7F7F6;border:1px solid #C6C9CC;border-radius:24px">
<tr><td align="center" style="padding:32px 32px 0">
  <table role="presentation" cellpadding="0" cellspacing="0"><tr><td class="gd tx" width="72" height="72" align="center" valign="middle" bgcolor="#E0B04B" style="width:72px;height:72px;border-radius:36px;background:#E0B04B;background-image:linear-gradient(135deg,#E0B04B,#8AA0B6);font-size:34px;line-height:72px;font-weight:700;color:#1F2428">&#8599;</td></tr></table>
</td></tr>
<tr><td align="center" style="padding:16px 32px 0;font-size:22px;font-weight:700;color:#1F2428" class="tx">Marketplace</td></tr>
<tr><td style="padding:24px 32px 32px;font-size:15px;line-height:1.6;color:#1F2428" class="tx"><#nested></td></tr>
</table>
<p class="sf" style="font-size:12px;color:#4E565C;margin:16px 0 0">Mensagem automática, não responda este e-mail.</p>
</td></tr></table></body></html>
</#macro>
