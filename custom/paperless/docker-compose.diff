       - /mnt/raid/paperless/consume:/usr/src/paperless/consume
+
+  # Proxy que injeta a marca Stevanini (CSS, favicon, título do login).
+  brand:
+    image: nginx:alpine
+    container_name: paperless-brand
+    restart: unless-stopped
+    depends_on: [webserver]
+    ports: ["8000:80"]
+    volumes:
+      - ./stevanini/nginx.conf:/etc/nginx/conf.d/default.conf:ro
+      - ./stevanini:/stevanini:ro
