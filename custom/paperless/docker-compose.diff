--- docker-compose.yml.bak-stevanini	2026-11-06 16:28:19.790216333 -0300
+++ docker-compose.yml	2026-11-06 16:29:39.808819306 -0300
@@ -15,15 +15,27 @@
     container_name: paperless
     restart: unless-stopped
     depends_on: [db, broker]
-    ports: ["8000:8000"]
+    expose: ["8000"]
     env_file: .env
     environment:
       PAPERLESS_REDIS: redis://broker:6379
       PAPERLESS_DBHOST: db
       PAPERLESS_APP_TITLE: Stevanini Documents
