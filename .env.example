ZITADEL_MASTERKEY=
# openssl rand -base64 32
LOGIN_SESSION_COOKIE_SECRET=
ZITADEL_DB_NAME=zitadel
ZITADEL_DB_USER=zitadel
ZITADEL_DB_PASSWORD=

